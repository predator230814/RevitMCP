<Project>
  <!-- Optional local override, for example to set RevitVersion when building the add-in in an IDE. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en-US</NeutralLanguage>
    <IsPackable>false</IsPackable>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Nice3pointRevitApi2025>2025.4.60</Nice3pointRevitApi2025>
    <Nice3pointRevitApi2026>2026.4.10</Nice3pointRevitApi2026>
    <Nice3pointRevitApi2027>2027.2.0</Nice3pointRevitApi2027>
  </PropertyGroup>

  <!--
    These paths must be set before Microsoft.Common.props is imported so 2025/2026
    (same TFM) and NuGet restore artifacts do not overwrite each other.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'RevitMCP.Addin' AND ('$(RevitVersion)' == '2025' OR '$(RevitVersion)' == '2026' OR '$(RevitVersion)' == '2027')">
    <BaseOutputPath>bin\$(RevitVersion)\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\$(RevitVersion)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)\obj\$(RevitVersion)\</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'RevitMCP.Addin'">
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2025'">$(Nice3pointRevitApi2025)</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2026'">$(Nice3pointRevitApi2026)</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitVersion)' == '2027'">$(Nice3pointRevitApi2027)</RevitApiPackageVersion>
    <!-- Restore of referenced Addin projects may not receive RevitVersion; keep a compile-time default. -->
    <RevitApiPackageVersion Condition="'$(RevitApiPackageVersion)' == ''">$(Nice3pointRevitApi2026)</RevitApiPackageVersion>
  </PropertyGroup>
</Project>

