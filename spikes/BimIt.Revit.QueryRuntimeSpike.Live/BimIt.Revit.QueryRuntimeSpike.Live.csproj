<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BimIt.Revit.QueryRuntimeSpike.Live</RootNamespace>
    <RevitVersion>2026</RevitVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Description>Opt-in Revit command for the query-runtime spike. Not installed and not referenced by the production Addin.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BimIt.Revit.QueryRuntimeSpike\BimIt.Revit.QueryRuntimeSpike.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="BimIt.Revit.QueryRuntimeSpike.Live.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
