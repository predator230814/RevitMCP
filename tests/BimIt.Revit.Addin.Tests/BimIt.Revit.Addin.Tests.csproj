<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BimIt.Revit.Addin.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures\*.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BimIt.Revit.Addin\BimIt.Revit.Addin.csproj">
      <AdditionalProperties>RevitVersion=$(RevitVersion)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyRevitApiReference" AfterTargets="ResolveAssemblyReferences">
    <Copy SourceFiles="@(ReferencePath)" DestinationFolder="$(OutputPath)revit-ref\" Condition="'%(Filename)' == 'RevitAPI'" SkipUnchangedFiles="true" />
  </Target>

  <!-- Loadable stand-in for the Nice3point 26.4.10 reference assembly, which cannot be executed. -->
  <Target Name="CopyLoadableRevitApi" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)RevitApiLoad\RevitApiLoadStub.dll" DestinationFiles="$(OutputPath)revit-load\RevitAPI.dll" SkipUnchangedFiles="true" />
  </Target>
</Project>
