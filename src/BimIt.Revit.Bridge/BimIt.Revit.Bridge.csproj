<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BimIt.Revit.Bridge</RootNamespace>
    <AssemblyName>BimIt.Revit.Bridge</AssemblyName>
    <Description>Local bridge abstractions shared by the MCP server and Revit add-in. No Revit API or MCP SDK dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
    <!-- StreamJsonRpc 2.25.29 pulls MessagePack 2.5.302, which NU1902 rejects. Stay on the 2.x line. -->
    <PackageReference Include="MessagePack" />
    <ProjectReference Include="..\BimIt.Revit.Contracts\BimIt.Revit.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BimIt.Revit.Bridge.Tests" />
  </ItemGroup>
</Project>
