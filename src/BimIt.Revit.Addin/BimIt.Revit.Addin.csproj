<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>BimIt.Revit.Addin</RootNamespace>
    <AssemblyName>BimIt.Revit.Addin</AssemblyName>
    <Description>In-process Revit capability host. Built once per supported RevitVersion.</Description>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Fallback TFM lets MSBuild evaluate the project so ValidateRevitVersion can
      emit a clear error instead of the generic "TargetFramework not specified" failure.
    -->
    <TargetFramework Condition="'$(RevitVersion)' == '2025'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2025'">
    <DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
    <WebView2PackageVersion>1.0.2045.28</WebView2PackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2026'">
    <DefineConstants>$(DefineConstants);REVIT2026</DefineConstants>
    <WebView2PackageVersion>1.0.2478.35</WebView2PackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2027'">
    <DefineConstants>$(DefineConstants);REVIT2027</DefineConstants>
    <WebView2PackageVersion>1.0.2478.35</WebView2PackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WebView2PackageVersion)' == ''">
    <WebView2PackageVersion>1.0.2478.35</WebView2PackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2025' OR '$(RevitVersion)' == '2026' OR '$(RevitVersion)' == '2027'">
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!--
      Revit loads this class library by path. Copy the resolved NuGet runtime graph
      next to the add-in so StreamJsonRpc and its dependencies are available in-process.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BimIt.Revit.Bridge\BimIt.Revit.Bridge.csproj" />
    <ProjectReference Include="..\BimIt.Revit.Assistant.Ipc\BimIt.Revit.Assistant.Ipc.csproj" />
    <ProjectReference Include="..\BimIt.Revit.Compiler\BimIt.Revit.Compiler.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(BimItApiAccessSpike)' == 'true'">
    <DefineConstants>$(DefineConstants);BIMIT_API_ACCESS_SPIKE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BimIt.Revit.Addin.Tests" />
    <InternalsVisibleTo Include="BimIt.Revit.Compiler.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(BimItApiAccessSpike)' == 'true'">
    <InternalsVisibleTo Include="BimIt.Revit.ApiAccessSpike.Tests" />
    <Compile Include="..\..\spikes\BimIt.Revit.ApiAccessSpike\*.cs" Link="ApiAccessSpike\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" VersionOverride="$(RevitApiPackageVersion)">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" VersionOverride="$(RevitApiPackageVersion)">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Web.WebView2" VersionOverride="$(WebView2PackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Approval\Ui\index.html" Link="ui\index.html" CopyToOutputDirectory="Always" />
    <Content Include="Approval\Ui\app.js" Link="ui\app.js" CopyToOutputDirectory="Always" />
    <Content Include="Approval\Ui\app.css" Link="ui\app.css" CopyToOutputDirectory="Always" />
    <Content Include="Assistant\Ui\index.html" Link="assistant-ui\index.html" CopyToOutputDirectory="Always" />
    <Content Include="Assistant\Ui\assistant-markdown.js" Link="assistant-ui\assistant-markdown.js" CopyToOutputDirectory="Always" />
    <Content Include="Assistant\Ui\app.js" Link="assistant-ui\app.js" CopyToOutputDirectory="Always" />
    <Content Include="Assistant\Ui\app.css" Link="assistant-ui\app.css" CopyToOutputDirectory="Always" />
    <Content Include="Assistant\Ui\logo.png" Link="assistant-ui\logo.png" CopyToOutputDirectory="Always" />
    <Content Include="Assistant\Ribbon\assistant-16.png" Link="assistant-ribbon\assistant-16.png" CopyToOutputDirectory="Always" />
    <Content Include="Assistant\Ribbon\assistant-32.png" Link="assistant-ribbon\assistant-32.png" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="bin\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="bin\**" />
    <None Remove="obj\**" />
  </ItemGroup>

  <Target Name="ValidateRevitVersion" BeforeTargets="PrepareForBuild">
    <Error
      Text="BimIt.Revit.Addin requires an explicit RevitVersion MSBuild property. Supported values: 2025, 2026, 2027. Example: dotnet build src/BimIt.Revit.Addin/BimIt.Revit.Addin.csproj -p:RevitVersion=2026"
      Condition="'$(RevitVersion)' == ''" />
    <Error
      Text="Unsupported RevitVersion '$(RevitVersion)'. BimIt.Revit.Addin supports 2025, 2026, and 2027."
      Condition="'$(RevitVersion)' != '' AND '$(RevitVersion)' != '2025' AND '$(RevitVersion)' != '2026' AND '$(RevitVersion)' != '2027'" />
  </Target>

  <Target Name="RemoveRevitApiFromCopyLocal" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'RevitAPI' OR '%(Filename)' == 'RevitAPIUI'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(Filename)' == 'RevitAPI' OR '%(Filename)' == 'RevitAPIUI'" />
    </ItemGroup>
  </Target>

  <Target Name="AssertNoRevitApiInOutput" AfterTargets="Build" Condition="'$(RevitVersion)' == '2025' OR '$(RevitVersion)' == '2026' OR '$(RevitVersion)' == '2027'">
    <Error
      Text="RevitAPI.dll must not be copied into BimIt.Revit.Addin output. The Nice3point packages are compile-time references only."
      Condition="Exists('$(OutputPath)RevitAPI.dll')" />
    <Error
      Text="RevitAPIUI.dll must not be copied into BimIt.Revit.Addin output. The Nice3point packages are compile-time references only."
      Condition="Exists('$(OutputPath)RevitAPIUI.dll')" />
  </Target>

  <!--
    CopyToOutputDirectory=Always is not sufficient: the SDK copy skips unchanged
    files. These three trusted assets must be rewritten on every Addin build.
  -->
  <Target Name="RefreshApprovalUiAssets" BeforeTargets="AssertAddinRuntimePayload" Condition="'$(RevitVersion)' == '2025' OR '$(RevitVersion)' == '2026' OR '$(RevitVersion)' == '2027'">
    <Copy SourceFiles="Approval\Ui\index.html" DestinationFiles="$(OutputPath)ui\index.html" SkipUnchangedFiles="false" />
    <Copy SourceFiles="Approval\Ui\app.js" DestinationFiles="$(OutputPath)ui\app.js" SkipUnchangedFiles="false" />
    <Copy SourceFiles="Approval\Ui\app.css" DestinationFiles="$(OutputPath)ui\app.css" SkipUnchangedFiles="false" />
    <Copy SourceFiles="Assistant\Ui\index.html" DestinationFiles="$(OutputPath)assistant-ui\index.html" SkipUnchangedFiles="false" />
    <Copy SourceFiles="Assistant\Ui\assistant-markdown.js" DestinationFiles="$(OutputPath)assistant-ui\assistant-markdown.js" SkipUnchangedFiles="false" />
    <Copy SourceFiles="Assistant\Ui\app.js" DestinationFiles="$(OutputPath)assistant-ui\app.js" SkipUnchangedFiles="false" />
    <Copy SourceFiles="Assistant\Ui\app.css" DestinationFiles="$(OutputPath)assistant-ui\app.css" SkipUnchangedFiles="false" />
    <Copy SourceFiles="Assistant\Ui\logo.png" DestinationFiles="$(OutputPath)assistant-ui\logo.png" SkipUnchangedFiles="false" />
    <Copy SourceFiles="Assistant\Ribbon\assistant-16.png" DestinationFiles="$(OutputPath)assistant-ribbon\assistant-16.png" SkipUnchangedFiles="false" />
    <Copy SourceFiles="Assistant\Ribbon\assistant-32.png" DestinationFiles="$(OutputPath)assistant-ribbon\assistant-32.png" SkipUnchangedFiles="false" />
  </Target>

  <Target Name="AssertAddinRuntimePayload" AfterTargets="Build" Condition="'$(RevitVersion)' == '2025' OR '$(RevitVersion)' == '2026' OR '$(RevitVersion)' == '2027'">
    <Error
      Text="BimIt.Revit.Addin.dll is missing from add-in output at $(OutputPath)."
      Condition="!Exists('$(OutputPath)BimIt.Revit.Addin.dll')" />
    <Error
      Text="BimIt.Revit.Bridge.dll is missing from add-in output at $(OutputPath)."
      Condition="!Exists('$(OutputPath)BimIt.Revit.Bridge.dll')" />
    <Error
      Text="BimIt.Revit.Contracts.dll is missing from add-in output at $(OutputPath)."
      Condition="!Exists('$(OutputPath)BimIt.Revit.Contracts.dll')" />
    <Error
      Text="BimIt.Revit.Assistant.Ipc.dll is missing from add-in output at $(OutputPath)."
      Condition="!Exists('$(OutputPath)BimIt.Revit.Assistant.Ipc.dll')" />
    <Error
      Text="StreamJsonRpc.dll is missing from add-in output at $(OutputPath). CopyLocalLockFileAssemblies must copy the Bridge NuGet runtime graph."
      Condition="!Exists('$(OutputPath)StreamJsonRpc.dll')" />
    <Error
      Text="Nerdbank.Streams.dll is missing from add-in output at $(OutputPath). The StreamJsonRpc runtime graph is incomplete."
      Condition="!Exists('$(OutputPath)Nerdbank.Streams.dll')" />
    <Error
      Text="Microsoft.Web.WebView2.Core.dll is missing from add-in output at $(OutputPath)."
      Condition="!Exists('$(OutputPath)Microsoft.Web.WebView2.Core.dll')" />
    <Error
      Text="Microsoft.Web.WebView2.Wpf.dll is missing from add-in output at $(OutputPath)."
      Condition="!Exists('$(OutputPath)Microsoft.Web.WebView2.Wpf.dll')" />
    <Error
      Text="WebView2Loader.dll is missing from add-in output at $(OutputPath). The managed package native loader must be present at the output root or runtimes/win-x64/native."
      Condition="!Exists('$(OutputPath)WebView2Loader.dll') AND !Exists('$(OutputPath)runtimes\win-x64\native\WebView2Loader.dll')" />
    <Error
      Text="Bundled approval UI assets are missing from $(OutputPath)ui."
      Condition="!Exists('$(OutputPath)ui\index.html') OR !Exists('$(OutputPath)ui\app.js') OR !Exists('$(OutputPath)ui\app.css')" />
    <Error
      Text="Bundled Assistant UI assets are missing from $(OutputPath)assistant-ui."
      Condition="!Exists('$(OutputPath)assistant-ui\index.html') OR !Exists('$(OutputPath)assistant-ui\assistant-markdown.js') OR !Exists('$(OutputPath)assistant-ui\app.js') OR !Exists('$(OutputPath)assistant-ui\app.css') OR !Exists('$(OutputPath)assistant-ui\logo.png') OR !Exists('$(OutputPath)assistant-ribbon\assistant-16.png') OR !Exists('$(OutputPath)assistant-ribbon\assistant-32.png')" />
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)..\BimIt.Revit.CompilerHost\CompilerReferences.props" />

  <PropertyGroup>
    <CompilerHostProject>$(MSBuildThisFileDirectory)..\BimIt.Revit.CompilerHost\BimIt.Revit.CompilerHost.csproj</CompilerHostProject>
    <CompilerHostOutput>$(MSBuildThisFileDirectory)..\BimIt.Revit.CompilerHost\bin\$(Configuration)\net8.0\</CompilerHostOutput>
  </PropertyGroup>

  <Target Name="PackageCompilerHost" AfterTargets="Build" Condition="'$(RevitVersion)' == '2025' OR '$(RevitVersion)' == '2026' OR '$(RevitVersion)' == '2027'">
    <Exec Command="dotnet build &quot;$(CompilerHostProject)&quot; --configuration $(Configuration) --nologo" />
    <ItemGroup>
      <_CompilerHostFiles Include="$(CompilerHostOutput)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CompilerHostFiles)" DestinationFiles="@(_CompilerHostFiles->'$(OutputPath)compiler\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error
      Text="BimIt.Revit.CompilerHost.exe is missing from $(OutputPath)compiler."
      Condition="!Exists('$(OutputPath)compiler\BimIt.Revit.CompilerHost.exe')" />
    <Error
      Text="BimIt.Revit.CompilerHost.exe must not be copied to the Addin output root."
      Condition="Exists('$(OutputPath)BimIt.Revit.CompilerHost.exe')" />
    <Error
      Text="Roslyn compiler assemblies must not be copied to the Addin output root."
      Condition="Exists('$(OutputPath)Microsoft.CodeAnalysis.dll') OR Exists('$(OutputPath)Microsoft.CodeAnalysis.CSharp.dll')" />
    <ItemGroup>
      <_MissingPackagedCompilerReference Include="@(CompilerReferenceRequired)" Condition="!Exists('$(OutputPath)compiler\refs\$(CompilerReferenceMoniker)\%(Identity)')" />
    </ItemGroup>
    <Error
      Text="Packaged compiler reference %(_MissingPackagedCompilerReference.Identity) is missing from $(OutputPath)compiler\refs\$(CompilerReferenceMoniker)."
      Condition="'@(_MissingPackagedCompilerReference)' != ''" />
  </Target>

  <Target Name="ReportRevitBuild" AfterTargets="Build" Condition="'$(RevitVersion)' == '2025' OR '$(RevitVersion)' == '2026' OR '$(RevitVersion)' == '2027'">
    <Message
      Importance="high"
      Text="BimIt.Revit.Addin built for Revit $(RevitVersion) targeting $(TargetFramework) ($(DefineConstants)) using Nice3point Revit API $(RevitApiPackageVersion)" />
  </Target>
</Project>
