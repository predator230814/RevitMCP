<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BimIt.Revit.Assistant</RootNamespace>
    <AssemblyName>BimIt.Revit.Assistant</AssemblyName>
    <Description>Local BIM-IT Assistant process. MCP client of BimIt.Revit.Server. No Revit API and no approval authority.</Description>
    <!-- PDFium and Skia are supported on Windows. The Assistant process runs beside Revit on Windows. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="GitHub.Copilot.SDK" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="PDFtoImage" />
    <ProjectReference Include="..\BimIt.Revit.Assistant.Ipc\BimIt.Revit.Assistant.Ipc.csproj" />
    <ProjectReference Include="..\BimIt.Revit.Contracts\BimIt.Revit.Contracts.csproj" />
    <ProjectReference Include="..\BimIt.Revit.Skills\BimIt.Revit.Skills.csproj" />
  </ItemGroup>

  <!-- Built-in Skills ship as read-only content beside the executable. They are guidance files, never code. -->
  <ItemGroup>
    <Content Include="..\..\skills\built-in\**\*" LinkBase="skills" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BimIt.Revit.Assistant.Tests" />
  </ItemGroup>
</Project>
