<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RevitMCP.Addin</RootNamespace>
    <AssemblyName>RevitMCP.Addin</AssemblyName>
    <Description>In-process Revit capability host. Built once per supported RevitVersion.</Description>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Fallback TFM lets MSBuild evaluate the project so ValidateRevitVersion can
      emit a clear error instead of the generic "TargetFramework not specified" failure.
    -->
    <TargetFramework Condition="'$(RevitVersion)' == '2025'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2025'">
    <DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
    <WebView2PackageVersion>1.0.2045.28</WebView2PackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2026'">
    <DefineConstants>$(DefineConstants);REVIT2026</DefineConstants>
    <WebView2PackageVersion>1.0.2478.35</WebView2PackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2027'">
    <DefineConstants>$(DefineConstants);REVIT2027</DefineConstants>
    <WebView2PackageVersion>1.0.2478.35</WebView2PackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WebView2PackageVersion)' == ''">
    <WebView2PackageVersion>1.0.2478.35</WebView2PackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2025' OR '$(RevitVersion)' == '2026' OR '$(RevitVersion)' == '2027'">
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!--
      Revit loads this class library by path. Copy the resolved NuGet runtime graph
      next to the add-in so StreamJsonRpc and its dependencies are available in-process.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitMCP.Bridge\RevitMCP.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RevitMCP.Addin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" VersionOverride="$(RevitApiPackageVersion)">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" VersionOverride="$(RevitApiPackageVersion)">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Web.WebView2" VersionOverride="$(WebView2PackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Approval\Ui\index.html" Link="ui\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Approval\Ui\app.js" Link="ui\app.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Approval\Ui\app.css" Link="ui\app.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="bin\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="bin\**" />
    <None Remove="obj\**" />
  </ItemGroup>

  <Target Name="ValidateRevitVersion" BeforeTargets="PrepareForBuild">
    <Error
      Text="RevitMCP.Addin requires an explicit RevitVersion MSBuild property. Supported values: 2025, 2026, 2027. Example: dotnet build src/RevitMCP.Addin/RevitMCP.Addin.csproj -p:RevitVersion=2026"
      Condition="'$(RevitVersion)' == ''" />
    <Error
      Text="Unsupported RevitVersion '$(RevitVersion)'. RevitMCP.Addin supports 2025, 2026, and 2027."
      Condition="'$(RevitVersion)' != '' AND '$(RevitVersion)' != '2025' AND '$(RevitVersion)' != '2026' AND '$(RevitVersion)' != '2027'" />
  </Target>

  <Target Name="RemoveRevitApiFromCopyLocal" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'RevitAPI' OR '%(Filename)' == 'RevitAPIUI'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(Filename)' == 'RevitAPI' OR '%(Filename)' == 'RevitAPIUI'" />
    </ItemGroup>
  </Target>

  <Target Name="AssertNoRevitApiInOutput" AfterTargets="Build" Condition="'$(RevitVersion)' == '2025' OR '$(RevitVersion)' == '2026' OR '$(RevitVersion)' == '2027'">
    <Error
      Text="RevitAPI.dll must not be copied into RevitMCP.Addin output. The Nice3point packages are compile-time references only."
      Condition="Exists('$(OutputPath)RevitAPI.dll')" />
    <Error
      Text="RevitAPIUI.dll must not be copied into RevitMCP.Addin output. The Nice3point packages are compile-time references only."
      Condition="Exists('$(OutputPath)RevitAPIUI.dll')" />
  </Target>

  <Target Name="AssertAddinRuntimePayload" AfterTargets="Build" Condition="'$(RevitVersion)' == '2025' OR '$(RevitVersion)' == '2026' OR '$(RevitVersion)' == '2027'">
    <Error
      Text="RevitMCP.Addin.dll is missing from add-in output at $(OutputPath)."
      Condition="!Exists('$(OutputPath)RevitMCP.Addin.dll')" />
    <Error
      Text="RevitMCP.Bridge.dll is missing from add-in output at $(OutputPath)."
      Condition="!Exists('$(OutputPath)RevitMCP.Bridge.dll')" />
    <Error
      Text="RevitMCP.Contracts.dll is missing from add-in output at $(OutputPath)."
      Condition="!Exists('$(OutputPath)RevitMCP.Contracts.dll')" />
    <Error
      Text="StreamJsonRpc.dll is missing from add-in output at $(OutputPath). CopyLocalLockFileAssemblies must copy the Bridge NuGet runtime graph."
      Condition="!Exists('$(OutputPath)StreamJsonRpc.dll')" />
    <Error
      Text="Nerdbank.Streams.dll is missing from add-in output at $(OutputPath). The StreamJsonRpc runtime graph is incomplete."
      Condition="!Exists('$(OutputPath)Nerdbank.Streams.dll')" />
    <Error
      Text="Microsoft.Web.WebView2.Core.dll is missing from add-in output at $(OutputPath)."
      Condition="!Exists('$(OutputPath)Microsoft.Web.WebView2.Core.dll')" />
    <Error
      Text="Microsoft.Web.WebView2.Wpf.dll is missing from add-in output at $(OutputPath)."
      Condition="!Exists('$(OutputPath)Microsoft.Web.WebView2.Wpf.dll')" />
    <Error
      Text="WebView2Loader.dll is missing from add-in output at $(OutputPath). The managed package native loader must be present at the output root or runtimes/win-x64/native."
      Condition="!Exists('$(OutputPath)WebView2Loader.dll') AND !Exists('$(OutputPath)runtimes\win-x64\native\WebView2Loader.dll')" />
    <Error
      Text="Bundled approval UI assets are missing from $(OutputPath)ui."
      Condition="!Exists('$(OutputPath)ui\index.html') OR !Exists('$(OutputPath)ui\app.js') OR !Exists('$(OutputPath)ui\app.css')" />
  </Target>

  <Target Name="ReportRevitBuild" AfterTargets="Build" Condition="'$(RevitVersion)' == '2025' OR '$(RevitVersion)' == '2026' OR '$(RevitVersion)' == '2027'">
    <Message
      Importance="high"
      Text="RevitMCP.Addin built for Revit $(RevitVersion) targeting $(TargetFramework) ($(DefineConstants)) using Nice3point Revit API $(RevitApiPackageVersion)" />
  </Target>
</Project>
